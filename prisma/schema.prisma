// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String               @id @default(cuid())
  role           userType             @default(USER)
  firstName      String?
  lastName       String?
  email          String?              @unique
  password       String?
  isVerified     Boolean              @default(false)
  isDisabled     Boolean              @default(false)
  classRoom      ClassRoom[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  orgMemberships OrganizationMember[]

  @@map("users")
}

model Organization {
  id           String               @id @default(cuid())
  name         String
  type         OrganizationType     @default(PERSONAL)
  members      OrganizationMember[]
  subscription Subscription?        @relation("OrgSubscription")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model OrganizationMember {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrganizationMemberRole @default(USER)
  joinedAt       DateTime               @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Subscription {
  id                  String             @id @default(cuid())
  organizationId      String             @unique
  organization        Organization       @relation("OrgSubscription", fields: [organizationId], references: [id], onDelete: Cascade)
  planId              String
  plan                Plan               @relation(fields: [planId], references: [id])
  status              SubscriptionStatus @default(PENDING)
  maxMembersSnapshot  Int                @default(1)
  priceAmountSnapshot Decimal            @db.Decimal(10, 2)
  currencySnapshot    String             @default("PHP")
  xenditCustomerId    String?
  xenditPlanId        String?            @unique
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  invoices            Invoice[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([planId])
  @@index([status, currentPeriodEnd])
}

model WebhookDelivery {
  id          String    @id
  provider    String    @default("XENDIT")
  eventId     String?   @unique
  event       String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([receivedAt])
  @@map("webhook_deliveries")
}

model Plan {
  id              String         @id @default(cuid())
  code            PlanType       @unique
  name            String
  maxMembers      Int
  priceAmount     Decimal        @db.Decimal(10, 2)
  currency        String         @default("PHP")
  billingInterval String         @default("YEAR")
  providerPlanId  String?
  active          Boolean        @default(true)
  subscriptions   Subscription[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Invoice {
  id                        String               @id @default(cuid())
  subscriptionId            String
  subscription              Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoiceNumber             String               @unique
  status                    InvoiceStatus        @default(PENDING)
  currency                  String
  subtotalAmount            Decimal              @db.Decimal(10, 2)
  taxAmount                 Decimal              @default(0) @db.Decimal(10, 2)
  totalAmount               Decimal              @db.Decimal(10, 2)
  amountPaid                Decimal              @default(0) @db.Decimal(10, 2)
  billingSnapshotEncrypted  String?              @db.Text
  billingSnapshotKeyVersion String?
  recipientEmailEncrypted   String?              @db.Text
  recipientEmailKeyVersion  String?
  emailStatus               InvoiceEmailStatus   @default(PENDING)
  emailSentAt               DateTime?
  emailFailureReason        String?
  invoicePdfUrl             String?
  providerInvoiceId         String?              @unique
  issuedAt                  DateTime?
  dueAt                     DateTime?
  paidAt                    DateTime?
  transactions              PaymentTransaction[]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@index([subscriptionId])
  @@index([status, issuedAt])
}

model PaymentTransaction {
  id                        String   @id @default(cuid())
  invoiceId                 String
  invoice                   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  provider                  String   @default("XENDIT")
  providerPaymentId         String?  @unique
  status                    String
  amount                    Decimal  @db.Decimal(10, 2)
  currency                  String
  providerPayloadEncrypted  String?  @db.Text
  providerPayloadKeyVersion String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([invoiceId])
  @@index([provider, status])
}

model ClassRoom {
  id         String    @id @default(cuid())
  name       String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime  @default(now())
  schoolYear String
  archived   Boolean   @default(false)
  students   Student[]

  @@index([userId])
  @@index([userId, schoolYear])
}

model Student {
  id          String       @id @default(cuid())
  name        String
  level       Int
  classRoom   ClassRoom    @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  classRoomId String
  assessments Assessment[]
  archived    Boolean      @default(false)

  @@index([classRoomId])
}

model Assessment {
  id        String         @id @default(cuid())
  studentId String
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  passageId String
  passage   Passage        @relation(fields: [passageId], references: [id])
  dateTaken DateTime       @default(now())
  type      AssessmentType

  assessmentLink    AssessmentLink?
  oralReadingResult OralReadingResult?
  comprehensionResult ComprehensionResult?
  oralFluencyResult   OralFluencyResult?

  @@index([studentId])
  @@index([passageId])
  @@index([studentId, dateTaken(sort: Desc)])
}

model AssessmentLink {
  id           String     @id @default(cuid())
  token        String     @unique
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  used         Boolean    @default(false)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([token])
}

model OralReadingResult {
  id                  String              @id @default(cuid())
  assessmentId        String              @unique
  assessment          Assessment          @relation(fields: [assessmentId], references: [id])
  fluencyLevel        LevelClassification
  comprehensionLevel  LevelClassification
  classificationLevel LevelClassification
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model OralFluencyResult {
  id                  String               @id @default(cuid())
  assessmentId        String?              @unique
  audioUrl            String               @default("")
  transcript          String?              @db.Text
  wordsPerMinute      Float?
  accuracy            Float?
  totalWords          Int?
  totalMiscues        Int?
  duration            Float?
  oralFluencyScore    Float?
  classificationLevel LevelClassification?
  otherObservations   String?              @db.Text

  status    OralFluencyStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  assessment     Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  miscues        OralFluencyMiscue[]
  behaviors      OralFluencyBehavior[]
  wordTimestamps WordTimestamp[]

  @@map("OralFluencySession")
}

model WordTimestamp {
  id         String @id @default(cuid())
  sessionId  String
  word       String
  startTime  Float
  endTime    Float
  confidence Float?
  index      Int

  oralFluencyResult OralFluencyResult @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model OralFluencyMiscue {
  id              String     @id @default(cuid())
  sessionId       String
  miscueType      MiscueType
  expectedWord    String
  spokenWord      String?
  wordIndex       Int
  timestamp       Float?
  isSelfCorrected Boolean    @default(false)
  createdAt       DateTime   @default(now())

  oralFluencyResult OralFluencyResult @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model OralFluencyBehavior {
  id           String                  @id @default(cuid())
  sessionId    String
  behaviorType OralFluencyBehaviorType
  startIndex   Int?
  endIndex     Int?
  startTime    Float?
  endTime      Float?
  notes        String?
  createdAt    DateTime                @default(now())

  oralFluencyResult OralFluencyResult @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Passage {
  id          String       @id @default(cuid())
  title       String
  content     String
  language    String
  level       Int
  testType    testType
  assessments Assessment[]
  quiz        Quiz?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ComprehensionResult {
  id                  String                @id @default(cuid())
  assessmentId        String                @unique
  assessment          Assessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  score               Int
  totalItems          Int
  classificationLevel LevelClassification
  answers             ComprehensionAnswer[]

  @@map("ComprehensionTest")
}

model ComprehensionAnswer {
  id                  String            @id @default(cuid())
  comprehensionResultId String @map("comprehensionTestId")
  comprehensionResult   ComprehensionResult @relation(fields: [comprehensionResultId], references: [id], onDelete: Cascade)
  question            String
  tag                 Tags
  answer              String
  isCorrect           Boolean?
  createdAt           DateTime          @default(now())

  @@index([comprehensionResultId])
}

model Quiz {
  id          String     @id @default(cuid())
  passageId   String     @unique
  passage     Passage    @relation(fields: [passageId], references: [id], onDelete: Cascade)
  questions   Question[]
  totalScore  Int
  totalNumber Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Question {
  id            String       @id @default(uuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText  String
  tags          Tags
  type          QuestionType
  options       Json?
  correctAnswer String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([quizId])
}

enum AssessmentType {
  ORAL_READING
  COMPREHENSION
  READING_FLUENCY
}

enum userType {
  USER
  ADMIN
  ORG_ADMIN
  PASSAGE_ADMIN
}

enum OrganizationType {
  PERSONAL
  TEAM
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  USER
}

enum testType {
  PRE_TEST
  POST_TEST
}

enum QuestionType {
  MULTIPLE_CHOICE
  ESSAY
}

enum Tags {
  Literal
  Inferential
  Critical
}

enum OralFluencyStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MiscueType {
  OMISSION
  MISPRONUNCIATION
  SUBSTITUTION
  REVERSAL
  TRANSPOSITION
  INSERTION
  SELF_CORRECTION
  REPETITION
}

enum OralFluencyBehaviorType {
  WORD_BY_WORD_READING
  MONOTONOUS_READING
  DISMISSAL_OF_PUNCTUATION
  VOICE_HARDLY_AUDIBLE
  FINGER_POINTING
  LITTLE_OR_NO_ANALYSIS
}

enum LevelClassification {
  INDEPENDENT
  INSTRUCTIONAL
  FRUSTRATION
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
}

enum InvoiceStatus {
  PENDING
  PAID
  VOID
  FAILED
}

enum InvoiceEmailStatus {
  PENDING
  SENT
  FAILED
}

enum PlanType {
  SOLO
  KASALO
  PANALO
  PAMILYA
}
